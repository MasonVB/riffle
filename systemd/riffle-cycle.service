[Unit]
Description=riffle wake cycle
After=llama-composer.service network-online.target
Wants=llama-composer.service

[Service]
Type=oneshot
User=riffle
Group=riffle
WorkingDirectory=/opt/riffle
ExecStart=/usr/bin/python3 -m agent.cycle --config /opt/riffle/config.yaml
TimeoutStartSec=2700

# A cycle needs to read text over HTTPS and write one SQLite file. Nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=riffle
StateDirectoryMode=0700
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
