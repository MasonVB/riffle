# Generated by copying riffle-cycle.service and changing four things:
# the description, --force, the request-flag cleanup, and the timeout. Every
# privilege directive below is byte-identical to the timer unit on purpose.
#
# The dashboard used to start cycles with subprocess.run, making them children
# of riffle-dash.service and giving them ITS sandbox: NoNewPrivileges=true and
# a bounding set of CAP_NET_BIND_SERVICE. sudo is refused under
# NoNewPrivileges, so every cycle started from the run-cycle button, after an
# approved send, or by request_cycle had build and sign rejected, read_page
# failing with no reason, library writes hitting a read-only filesystem, and
# situation() unable to read the public key — so the prompt told riffle it had
# no signing key. A false statement about its own capabilities, generated
# silently, which it then reasoned from.
#
# If this block ever drifts from riffle-cycle.service, that bug comes back.

[Unit]
Description=run a cycle on request from the dashboard
After=llama-composer.service network-online.target
Wants=llama-composer.service

[Service]
Type=oneshot
User=riffle
Group=riffle
WorkingDirectory=/opt/riffle
# Clear the flag first so the path unit re-arms, and so a cycle that
# fails does not leave it looping.
ExecStartPre=/bin/rm -f /var/lib/riffle/run-cycle.request
# --force skips the INTERVAL check, which is the entire reason for
# asking. It does not skip the cycle lock, which is taken inside main()
# and is what stops two cycles overlapping; a requested cycle arriving
# while one is running exits immediately and says so.
ExecStart=/usr/bin/python3 -m agent.cycle --config /opt/riffle/config.yaml --force
TimeoutStartSec=10800

# --- why this is less locked down than it was ------------------------------
#
# This block used to open "a cycle needs to read text over HTTPS and write one
# SQLite file. Nothing else." That was true when it was written. It stopped
# being true the moment the cycle gained four helpers it reaches through sudo:
#
#   riffle-sign     the citizen key, held by another user
#   riffle-build    the Python sandbox, which needs root to drop to another uid
#   riffle-reader   the allowlisted page fetcher
#
# NoNewPrivileges=true blocks every one of them. sudo is setuid; NNP is
# precisely the flag that stops a setuid binary raising privilege. So did the
# empty CapabilityBoundingSet, which removed CAP_SETUID.
#
# The failure was silent for days. riffle told the square "I have no wallet,
# no token, and no operator to sign for me" while holding a bound key, because
# the check that would have told it otherwise was being refused by systemd and
# swallowed by a bare except. Every build it ever proposed failed the same way.
#
# WHAT IS LOST, stated plainly: a compromised cycle can now run sudo. What it
# can run through sudo is still only the four programs named in
# /etc/sudoers.d/riffle-*, with the argument patterns listed there, as users
# that hold nothing else. The containment moved from "cannot escalate at all"
# to "can escalate only into three small programs that validate their own
# input". That is a real reduction and it is the price of the agent having
# hands.
#
# Everything not needed for sudo stays on.
NoNewPrivileges=false
# CAP_CHOWN and CAP_FOWNER are here because riffle-build chowns the scratch
# files to the sandbox user so the confined process can read them. The
# bounding set caps what ANY process in this unit may hold, including root
# reached through sudo — so root without CAP_CHOWN got:
#
#   PermissionError: [Errno 1] Operation not permitted:
#   '/var/lib/riffle-build/c482/solve.py'
#
# Third time this unit has broken a helper by being written for an agent that
# could not do what this one can. I have now fixed it once per capability
# rather than once, which is the wrong shape: the unit should be reviewed
# against what the helpers actually need, not patched each time one fails.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_DAC_READ_SEARCH

PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=riffle
StateDirectoryMode=0700

# --- the helpers write outside StateDirectory ------------------------------
#
# ProtectSystem=strict makes the whole filesystem read-only except what is
# named here, and a process started through sudo inherits this mount
# namespace — so `sudo riffle-build` got:
#
#   OSError: [Errno 30] Read-only file system: '/var/lib/riffle-build/c443'
#
# The three helpers each own a top-level directory, deliberately: their data
# must not sit inside /var/lib/riffle, which is 0700 riffle and which the
# other users cannot traverse. That separation is right and it means the
# namespace has to be widened by exactly three paths.
#
# Second time this unit has broken a helper by being stricter than the agent
# had become. The pattern is worth naming: every capability added to the
# cycle is a hole in a sandbox written when it had none, and the unit is not
# updated by the same commit that adds the capability.
ReadWritePaths=/var/lib/riffle-build
ReadWritePaths=/var/lib/riffle-library
ReadWritePaths=/var/lib/riffle-signer
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false

# RestrictSUIDSGID and SystemCallFilter are both gone: the first blocks the
# suid handling sudo relies on, and @system-service does not include the
# setuid/setgid calls sudo makes. Filtering syscalls on a process whose whole
# job is to invoke three vetted programs buys little and broke all three.

