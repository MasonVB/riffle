[Unit]
Description=riffle LAN dashboard
After=network-online.target

[Service]
User=riffle
Group=riffle
WorkingDirectory=/opt/riffle
ExecStart=/usr/bin/python3 -m agent.dash --config /opt/riffle/config.yaml
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=riffle
StateDirectoryMode=0700
# The dashboard can trigger writes to the square. Keep it on the LAN.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Binding port 80 unprivileged. CAP_NET_BIND_SERVICE permits low
# ports and nothing else — no root, no file access, no process
# control — and the bounding set holds it to exactly that one.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
