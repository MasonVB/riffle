[Unit]
Description=llama.cpp composer (MoE, writes)
After=network-online.target
# After= only orders; without Wants= the target is never pulled in, so
# the unit can start before the network is actually up.
Wants=network-online.target

[Service]
User=riffle
Group=riffle
# -t 6 = one thread per physical core. The 8500T has no SMT, so 6 is the
# ceiling and oversubscribing costs throughput.
# NO --mlock, AND --cache-ram 1024 (was 3072), from 2026-10-25. The box had
# reset itself 11 times in six days, every boot ending abruptly with nothing
# in the kernel log, five of them mid prompt-processing or generation and
# one 51 s after boot. This service's MemoryPeak was 30.7 GB on a 31 GiB box,
# beside 5.1 GB for llama-triage, with --mlock making the weights
# unreclaimable: a box in that state can lock up before the OOM killer
# writes a line. Without --mlock the kernel can drop weight pages under
# pressure and read them back from the NVMe (a slower cycle, not a frozen
# box); the smaller cache-ram frees ~2 GiB and still holds one ~600 MiB
# prompt entry, so a chat or memory call between cycles need not cost the
# cycle's prefix. THIS IS A TEST of the memory explanation: if the resets
# continue, suspect hardware (memtest86+ next) and put --mlock back if
# cycles have slowed. LimitMEMLOCK below is left; it does nothing now.
# --cache-reuse would let the server reuse KV chunks that moved. IT DOES NOT
# WORK FOR THIS MODEL, with or without --kv-unified: measured 2026-10-24,
# the server still logs "cache_reuse is not supported by this context, it
# will be disabled" at every start. The flag is ignored and left in place;
# removing it would change nothing but needs a model reload.
#
# The prefix is reused anyway, by plain prompt caching (cache_prompt in each
# request): after a restart the first cycle processed 14,136 tokens, and
# each later one 7,000-7,800, so about 6,300-7,100 tokens of the stable
# prefix are reused per cycle. Prefill is still about 5 minutes at ~24
# tokens a second; what remains is the part of the prompt that changes.
#
# The history below is kept: --kv-unified was added believing it would make
# cache_reuse work. Before it the server logged
#
#   srv load_model: initializing, ..., kv_unified = 'false'
#   srv load_model: cache_reuse is not supported by this context, it will
#                   be disabled
#
# at every start, and has since this unit was written. So --cache-reuse 256
# was present, refused, and silently ignored: every cycle paid full prefill
# (~6 minutes for a 14k prompt at the measured 37.88 t/s), and --cache-ram
# churned a 3 GiB store evicting a ~600 MiB entry per cycle that could
# never be reused.
#
# With --parallel 1 there is one sequence, so a unified KV buffer costs no
# extra memory; it is a different layout, not a bigger one. Watch RSS after
# this change anyway — on a 32 GiB box next to a 20.6 GiB model, assume
# nothing.
#
# kv_unified does read 'true' now. The cache_reuse warning is still there,
# so that part of this change did not do what it was for.
ExecStart=/opt/llama.cpp/build/bin/llama-server \
  --model /opt/models/composer.gguf \
  --host 127.0.0.1 --port 8080 \
  --ctx-size 20480 --threads 6 --threads-batch 6 \
  --batch-size 512 --ubatch-size 128 \
  \
  --parallel 1 --kv-unified --chat-template-kwargs '{"enable_thinking":false}' \
  --cache-ram 1024 --cache-reuse 256 --slots --no-webui
Restart=always
RestartSec=10
Nice=0
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
