def die(msg, code=2):
    print(json.dumps({"ok": False, "error": msg}))
    sys.exit(code)


def host_ok(url):
    """Exact match or a subdomain of an allowed host. Never a suffix match.

    `evil-arxiv.org` must not pass because it ends with `arxiv.org`, so the
    check is equality or a dot-boundary prefix.
    """
    try:
        p = urllib.parse.urlparse(url)
    except ValueError:
        return None, "that is not a URL"
    if p.scheme != "https":
        return None, f"scheme {p.scheme!r} refused; https only"
    host = (p.hostname or "").lower()
    if not host:
        return None, "no host in that URL"
    if host in ALLOWED:
        return host, None
    for a in ALLOWED:
        if host.endswith("." + a):
            return host, None
    return None, (f"{host} is not on the reading allowlist. The list is "
                  f"sources a stranger cannot edit: official docs, standards "
                  f"bodies, government, peer-reviewed journals and preprint "
                  f"servers, curated encyclopedias.")


def fetch(url):
    """Follow redirects by hand so every hop is checked against the allowlist."""
    seen = []
    for _ in range(MAX_REDIRECTS + 1):
        host, why = host_ok(url)
        if why:
            die(why)
        seen.append(url)
        req = urllib.request.Request(url, headers={
            "User-Agent": UA,
            "Accept": "text/html,application/xhtml+xml,text/plain,application/pdf",
        })
        class NoRedirect(urllib.request.HTTPRedirectHandler):
            def redirect_request(self, *a, **k):
                return None
        opener = urllib.request.build_opener(NoRedirect)
        try:
            with opener.open(req, timeout=TIMEOUT) as r:
                return r.status, r.headers, r.read(MAX_BYTES), seen
        except urllib.error.HTTPError as e:
            if e.code in (301, 302, 303, 307, 308):
                loc = e.headers.get("Location")
                if not loc:
                    die(f"{e.code} with no Location header")
                url = urllib.parse.urljoin(url, loc)
                continue
            if e.code in (401, 403):
                # 403 is not only paywalls: a proxy, a bot filter or a
                # geo-block returns it too, and telling the agent "paywall"
                # when it was actually blocked sends it looking for an
                # abstract that does not exist. Say what is known.
                die(f"HTTP {e.code}: refused. That is usually a paywall or "
                    f"login, but a bot filter or a proxy returns it too. If "
                    f"this is a journal, the abstract page may still be "
                    f"readable; if it is documentation, something is blocking "
                    f"the request rather than the content being restricted.")
            if e.code == 429:
                die("HTTP 429: rate limited. Wait rather than retrying.")
            die(f"HTTP {e.code}")
        except Exception as e:
            die(f"could not reach it: {type(e).__name__}: {e}")
    die(f"more than {MAX_REDIRECTS} redirects")


_TAG = re.compile(r"<[^>]+>")
_DROP = re.compile(r"<(script|style|nav|footer|header|form|svg)[^>]*>.*?</\1>",
                   re.S | re.I)
_WS = re.compile(r"\n\s*\n\s*\n+")


def to_text(raw, ctype):
    if "pdf" in (ctype or "").lower():
        return ("[This is a PDF. Only its bytes were fetched; there is no text "
                "extraction here. Shelve the URL and read the abstract page "
                "instead.]")
    s = raw.decode("utf-8", "replace")
    s = _DROP.sub(" ", s)
    s = re.sub(r"<br\s*/?>|</p>|</div>|</h[1-6]>", "\n", s, flags=re.I)
    s = _TAG.sub(" ", s)
    s = html.unescape(s)
    s = re.sub(r"[ \t]+", " ", s)
    s = _WS.sub("\n\n", s).strip()
    return s[:MAX_TEXT]


def main():
    ap = argparse.ArgumentParser(prog="riffle-reader", description=__doc__)
    # --url is NOT required=True: that made --list-domains unrunnable, since
    # argparse rejected the call before main() could check the flag. The one
    # subcommand whose whole job is "tell me what I am allowed to read" could
    # not be used without naming something to read.
    ap.add_argument("--url", default="")
    ap.add_argument("--list-domains", action="store_true")
    a = ap.parse_args()
    if a.list_domains:
        print(json.dumps({"ok": True, "domains": sorted(ALLOWED)}))
        return
    if not a.url:
        die("give me --url, or --list-domains to see what is allowed")
    status, headers, raw, hops = fetch(a.url)
    text = to_text(raw, headers.get("Content-Type"))
    print(json.dumps({
        "ok": True, "url": hops[-1], "hops": hops, "status": status,
        "content_type": headers.get("Content-Type", ""),
        "bytes": len(raw), "chars": len(text), "text": text}))


if __name__ == "__main__":
    main()
